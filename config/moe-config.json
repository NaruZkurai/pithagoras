      "points_500x": 500,
      "note": "500x when the 5-token compression footprint token appears in the top-k of the next-5 AND a match is in the top-100 of the next 5 generated tokens"
    },
    "penalties": {
      "overconfidence": 0,
      "redundant_expert": 0,
