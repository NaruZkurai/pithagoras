  "routing": {
   "type": "top-2",
   "note": "only the TOP 2 experts by top-k affinity are kept active for the token set"
  }
 },
 "scoring": {
  "base": {
   "per_topk_token_match": 53009,
   "per_topp_token_match": 53009,
   "per_teacher_emit_match": 100000,
   "note": "+1 per token in student's top-n/k that's in teacher's top-n/k; +1 per token in student's top-n/p that's in teacher's top-n/p; +2 per student CHOSEN token that's in the teacher's ACTUAL emitted top-k"
  },
  "bonus": {
   "points_per_step_times_100": true,
   "note": "bonus = 100 * step (running); top-k allowed is wide now, will narrow later"
  },
  "value_generation": {
   "compressed_token_sentinel": 999993,
   "points_500x": 50,
   "note": "500x when the 5-token compression footprint token appears in the top-k of the next-5 AND a match is in the top-100 of the next 5 generated tokens"
  },
  "penalties": {
   "overconfidence": 100000,
   "redundant_expert": 0,
   "note": "subtract from total when flagged; adjust live via UI"
  },
  "curve": {
   "enabled": true,
   "exp_base": 2.0,
   "exp_scaler": 4.0,
   "note": "exponential reward for matching the (perfect) teacher's top-k curve: each matched teacher slot i pays per_topk_token_match * exp_base^((i+1)/exp_scaler), so MORE matches = MORE reward (progressively). A compressed token that lands on a teacher slot counts and is multiplied by compressed_token_mult. New-token-system tokens in the teacher top-k are also heavily rewarded.",
   "compressed_token_mult": 4.0
  },
  "compression": {
   "enabled": true,
   "base_effective_tokens": 5,
   "reference_tokens": 23,
   "text_length_factor": 1.0,
   "multiplier": 1.0,
   "new_token_match_mult": 1.001,
   "new_token_match_min_pct": 0.2,
   "tally_before_reset": true,
   "note": "compression_reward = compressionRatio * baseEffectiveTokens * ( 1 + textLengthGenerated / tokensSaved ) ; \ncompressionRatio = referenceTokens / emittedTokens ; tokensSaved = referenceTokens - emittedTokens. If >=min_pct of generated tokens match new-token-system created tokens, multiply by new_token_match_mult * tokensSaved."
  }
 },
 "sampling": {
  "view_top_k": 40,
  "emit": {
   "teacher": {
    "top_k": 20,
    "top_p": 0.95,
    "temperature": 0.7
   },
   "student": {
    "top_k": 100,
    "top_p": 0.95,
    "temperature": 0.7
   }
  },
  "noise_to_layer": 0.1,
  "note": "top-k sliders are capped at 100 (NOT 100k). view_top_k = how many top tokens the model looks at (logprobs); emit.* limits top-k/top-p/temperature sampling so the teacher stays coherent. noise_to_layer = per-token noise added to layers for the next output token."
 },
 "layers": {
  "count": 44,
  "each": {
   "training_formula": "layer_weight_adj = lr * (teacher_value - student_value) * topk_gate",
   "lr": 0.01,
   "topk_gate": 0.5
  }
 },
 "training": {
  "steps_per_round": 5,
  "rounds_before_reset": 3,
  "note": "expert values/scores persist and accumulate for steps_per_round * rounds_before_reset total steps, then reset (keeping a last_round snapshot for comparison). Set rounds_before_reset to control how many rounds before the reset happens."
 },
 "expert_policy": {
  "top_n_survive": 10,
  "update_non_top": true,
  "update_losing_experts": "auto",
  "losing_experts_update_every": 100,
  "reset_from_last_window": false,
  "note": "at each round reset: top_n_survive experts keep their values. update_losing_experts = how many of the WORST (weakest) experts get updated; every losing_experts_update_every steps those losing experts are re-seeded from the previous window's data (reset_from_last_window=true) or fresh. All adjustable.",
  "bottom_m_refresh": 2
 },
