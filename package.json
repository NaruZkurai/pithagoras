{
  "name": "pithagoras",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web",
    "docs"
  ],
  "scripts": {
    "build": "npm run build -w server && npm run build -w web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "start": "node server/dist/index.js",
    "docs": "npm run dev -w docs",
    "docs:build": "npm run build -w docs"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.5": true,
    "@google/genai@1.52.0": true
  }
}
